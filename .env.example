# Copy to .env for local runs (`pnpm dev`). Docker Compose reads ADMIN_TOKEN and
# the provider keys from your shell or a .env file next to docker-compose.yml.

# Postgres. Locally: postgres://postgres:postgres@localhost:5432/sandboxrouter
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sandboxrouter

# The owner credential: use it to create API keys. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Providers: any provider without a key is not offered.
E2B_API_KEY=
# 1 on E2B Hobby, 24 on E2B Pro.
E2B_MAX_LIFETIME_HOURS=1
DAYTONA_API_KEY=
DAYTONA_TARGET=us
# Set DAYTONA_VM=true to also offer Daytona's Linux VM sandboxes (provider daytona-vm).
# DAYTONA_VM=

# Modal: offers modal-gvisor and modal-vm (MODAL_DISABLE_VM=true for gVisor only).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# MODAL_ENVIRONMENT=
# MODAL_APP_NAME=sandboxrouter
# MODAL_IMAGE=python:3.13-slim

# Vercel Sandbox: all three are required together.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# 0.75 on Hobby, 24 on Pro.
VERCEL_MAX_LIFETIME_HOURS=0.75

# Novita: build its size templates once (pnpm --filter @sr/providers build:novita-templates).
NOVITA_API_KEY=
# 1 on Free, 3 on Paid, 4 on Enterprise.
NOVITA_MAX_LIFETIME_HOURS=1

# boat
BOAT_API_KEY=
# 2 on trial, 720 on paid.
BOAT_MAX_LIFETIME_HOURS=2

PORT=8787
# Running sandboxes allowed at once (default 10).
# MAX_RUNNING_SANDBOXES=10
