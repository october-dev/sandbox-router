{
  "name": "sandboxrouter",
  "version": "0.1.0",
  "description": "TypeScript client for Sandbox Router: one API for cloud sandboxes on E2B, Daytona, Modal, Vercel Sandbox, Novita, boat and run.cloud.",
  "keywords": [
    "sandbox",
    "code-execution",
    "e2b",
    "daytona",
    "modal",
    "vercel-sandbox",
    "novita",
    "microvm",
    "ai-agents"
  ],
  "homepage": "https://github.com/october-dev/sandbox-router/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/october-dev/sandbox-router/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/october-dev/sandbox-router.git",
    "directory": "packages/sdk"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "sandboxrouter-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "eventsource-parser": "^4.1.3"
  }
}
